# --- سئو، لانچ و آنالیتیکس (همه فقط-سروری؛ تغییرشان دیپلوی تازه می‌خواهد) ---
# فقط مقدار دقیق true سایت را برای موتورهای جست‌وجو باز می‌کند (robots.txt و meta robots)
# ALLOW_INDEXING=true
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# UMAMI_WEBSITE_ID=
# روشن کردن آنالیتیکس بدون باز کردن ایندکس (مثلاً برای تست روی استیجینگ)
# ANALYTICS_ENABLED=true
# کلید وبهوک باطل‌سازی کش (/api/revalidate) برای وردپرس و پنل ادمین
# REVALIDATE_SECRET=
